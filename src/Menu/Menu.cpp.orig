#include "Menu.hpp"
#include "../Neo/Neo.hpp"

#include <iostream>
#include <memory>
#include <raylib.h>
#include <string>
#include <vector>

#pragma GCC diagnostic push
#pragma GCC diagnostic ignored "-Wnarrowing"
#pragma GCC diagnostic ignored "-Wsign-compare"
#pragma GCC diagnostic ignored "-Wunused-variable"
#pragma GCC diagnostic ignored "-Wmissing-field-initializers"
#define CLAY_IMPLEMENTATION
#include "clay.h"
#include "clay_renderer_raylib.c"
#pragma GCC diagnostic pop

void HandleClayErrors(Clay_ErrorData errorData) {
    std::cerr << errorData.errorText.chars << '\n';
}

Menu::Menu(Vector2 windowSize) {
  std::cout << "Menu Created" << '\n';
  this->apiInputBox = (Rectangle){500, 500, 30, 30};
  this->windowSize = windowSize;
  this->state = MenuState::Full;

  uint64_t totalMemorySize = Clay_MinMemorySize();
  this->clayMemory = Clay_CreateArenaWithCapacityAndMemory(totalMemorySize, malloc(totalMemorySize));
  Clay_Initialize(this->clayMemory, (Clay_Dimensions) { (float)windowSize.x, (float)windowSize.y }, (Clay_ErrorHandler) { HandleClayErrors, 0 });
  
  this->font = GetFontDefault();
  Clay_SetMeasureTextFunction(Raylib_MeasureText, &this->font);
}

Menu::~Menu() {
  if (this->clayMemory.memory) {
    free(this->clayMemory.memory);
  }
}

std::string Menu::GetTextBuffer() { return this->textInputBoxBuffer; }

#define STD_TO_CLAY(str) (Clay_String){ (int)(str).length(), (str).c_str() }

// go through all parts of the menu
void Menu::DisplayMenu(std::unique_ptr<Neo> &currentNeo) {

  if (IsKeyPressed(KeyboardKey::KEY_M)) {
    this->state = this->state == MenuState::Minimal ? MenuState::Full : MenuState::Minimal;
  }

  if (currentNeo == nullptr) return;

  Clay_SetPointerState(
      (Clay_Vector2){(float)GetMousePosition().x, (float)GetMousePosition().y},
      IsMouseButtonDown(0));
  
  Clay_SetLayoutDimensions((Clay_Dimensions) { (float)GetScreenWidth(), (float)GetScreenHeight() });

  Clay_BeginLayout();

  CLAY(CLAY_ID("MenuPanel"), {
    .layout = {
        .layoutDirection = CLAY_TOP_TO_BOTTOM,
        .sizing = { .width = CLAY_SIZING_FIXED(400), .height = CLAY_SIZING_FIT() },
        .padding = {16, 16, 16, 16},
        .childGap = 8
    },
    .backgroundColor = {102, 191, 255, 180},
    .border = { .width = {2, 2, 2, 2}, .color = {0, 0, 255, 255} },
    .floating = { .attachTo = CLAY_ATTACH_TO_PARENT, .offset = {10, 10} }
  }) {
      Clay_TextElementConfig textTitle = { .fontSize = 20, .textColor = {0, 0, 0, 255} };
      Clay_TextElementConfig textWhite = { .fontSize = 18, .textColor = {255, 255, 255, 255} };

      CLAY_TEXT(CLAY_STRING("Asteroid Info"), CLAY_TEXT_CONFIG(textTitle));

      std::string id = std::to_string(currentNeo->GetID());
      std::string ref_id = currentNeo->GetNeoID();
      std::string ids = "Neo Id: " + id + " Ref Id: " + ref_id;
      
      std::string kilo_max = std::to_string(std::get<1>(currentNeo->GetDiameter()->kilometer_min_max));
      std::string meter_max = std::to_string(std::get<1>(currentNeo->GetDiameter()->meter_min_max));
      std::string size = "Size (KM) " + kilo_max + " Size (M): " + meter_max;

      CLAY_TEXT(STD_TO_CLAY(ids), CLAY_TEXT_CONFIG(textWhite));
      CLAY_TEXT(STD_TO_CLAY(size), CLAY_TEXT_CONFIG(textWhite));

      if (this->state == MenuState::Full) {
          std::string miles_max = std::to_string(std::get<1>(currentNeo->GetDiameter()->miles_min_max));
          std::string feet_max = std::to_string(std::get<1>(currentNeo->GetDiameter()->feet_min_max));
          std::string altSize = "Size (Mi) " + miles_max + " Size (ft): " + feet_max;

          std::string neo_name = "Name: " + currentNeo->GetName();
          std::string neo_hazard = "Hazardous: " + std::to_string(currentNeo->GetHazardous());

          CLAY_TEXT(STD_TO_CLAY(neo_name), CLAY_TEXT_CONFIG(textWhite));
          CLAY_TEXT(STD_TO_CLAY(altSize), CLAY_TEXT_CONFIG(textWhite));
          CLAY_TEXT(STD_TO_CLAY(neo_hazard), CLAY_TEXT_CONFIG(textWhite));

          std::vector<std::unique_ptr<CloseApproach>> const &neo_approach = currentNeo->GetCloseApproach();
          if (!neo_approach.empty()) {
              std::string kps = "Approach KPH: " + neo_approach[0]->GetRelativeKPH() + " KPS: " + neo_approach[0]->GetRelativeKPS();
              std::string mps = "Approach MPH: " + neo_approach[0]->GetRelativeMPH();
              std::string miss_dist = "Miss KM: " + neo_approach[0]->GetMissKilo();
              std::string miss_miles = "Miss Mi: " + neo_approach[0]->GetMissMiles();

              CLAY_TEXT(STD_TO_CLAY(kps), CLAY_TEXT_CONFIG(textWhite));
              CLAY_TEXT(STD_TO_CLAY(mps), CLAY_TEXT_CONFIG(textWhite));
              CLAY_TEXT(STD_TO_CLAY(miss_dist), CLAY_TEXT_CONFIG(textWhite));
              CLAY_TEXT(STD_TO_CLAY(miss_miles), CLAY_TEXT_CONFIG(textWhite));
          }
      }
  }

  Clay_RenderCommandArray renderCommands = Clay_EndLayout(GetFrameTime());
  Clay_Raylib_Render(renderCommands, &this->font);
}

const void Menu::DisplayMinimalMenu(const std::unique_ptr<Neo> &n) {}
void Menu::DisplayFullMenu(std::unique_ptr<Neo> &neo) {}

void Menu::ClickIntoApiTextBox(Vector2 mousePos) {
  // Change color of menu if mouse hover
  if (CheckCollisionPointRec(mousePos, this->apiInputBox)) {
    return;
  }
}

void Menu::ApiButton(Vector2 mousePos) {
  // Button not clicked
  if (!IsKeyDown(MOUSE_BUTTON_LEFT) &&
      CheckCollisionPointRec(mousePos, this->apiInputBox))
    return;
}
